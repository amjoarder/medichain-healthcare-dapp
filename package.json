{
  "name": "blockchain-healthcare-data-sharing",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cost local blockchain healthcare record sharing DApp for MSc coursework.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "chai": "4.5.0",
    "eslint": "9.39.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-kubo.ps1 && node scripts/npm-cli.mjs install && node scripts/npm-cli.mjs --prefix frontend install && hardhat compile && node scripts/check-environment.mjs",
    "dev": "node scripts/start-dev.mjs",
    "stop": "node scripts/stop-dev.mjs",
    "ipfs:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ipfs.ps1 start",
    "ipfs:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ipfs.ps1 stop",
    "ipfs:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ipfs.ps1 status",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.ts --network localhost",
    "test:e2e": "node node_modules/tsx/dist/cli.mjs scripts/full-workflow.mts",
    "build": "node scripts/frontend-command.mjs build",
    "lint": "eslint scripts benchmarks eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node benchmarks/run-all.mjs",
    "reset": "node scripts/reset-local.mjs"
  }
}
